# Copy to .env (gitignored). Never commit or log keys. All are optional: each has a free fallback.
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
YOUTUBE_API_KEY=
# Imgflip paid plan: lets `memes templates <dir> <query>` search the full template list (the top list needs no key)
IMGFLIP_API_KEY=
